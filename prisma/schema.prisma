// BookSwap — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum BookCondition {
  LIKE_NEW
  VERY_GOOD
  GOOD
  ACCEPTABLE
}

enum BookStatus {
  AVAILABLE
  RESERVED
  EXCHANGE_PENDING
  EXCHANGED
  INACTIVE
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  PAYMENT_PENDING
  PAID
  CONFIRMED
  COMPLETED
  DISPUTED
  EXPIRED
}

enum ExchangeRole {
  REQUESTER
  RESPONDER
}

enum OfferStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryMode {
  MEETUP
  DELIVERY
}

enum NotificationType {
  EXCHANGE_REQUESTED
  EXCHANGE_ACCEPTED
  EXCHANGE_REJECTED
  COUNTER_OFFER
  PAYMENT_REQUIRED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  EXCHANGE_CONFIRMED
  EXCHANGE_COMPLETED
  EXCHANGE_CANCELLED
  WISHLIST_MATCH
  NEW_MESSAGE
  REVIEW_RECEIVED
  ACCOUNT
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum FeeType {
  FIXED
  PERCENTAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------- core

model User {
  id              String     @id @default(uuid())
  fullName        String
  email           String     @unique
  phone           String?
  passwordHash    String
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  searchRadiusKm  Int        @default(25) // 0 = anywhere
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile          Profile?
  addresses        Address[]
  books            Book[]
  wishlist         WishlistItem[]
  sessions         Session[]
  tokens           VerificationToken[]
  sentRequests     Exchange[]                @relation("ExchangeRequester")
  receivedRequests Exchange[]                @relation("ExchangeResponder")
  offers           ExchangeOffer[]
  payments         Payment[]
  messages         Message[]
  participations   ConversationParticipant[]
  notifications    Notification[]
  reviewsWritten   Review[]                  @relation("ReviewAuthor")
  reviewsGot       Review[]                  @relation("ReviewSubject")
  reportsFiled     Report[]                  @relation("ReportReporter")
  reportsAgainst   Report[]                  @relation("ReportTarget")
  blocking         Block[]                   @relation("Blocker")
  blockedBy        Block[]                   @relation("Blocked")

  @@index([status])
  @@index([createdAt])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  avatarUrl   String?
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String   @default("Home")
  fullName    String
  phone       String
  addressLine String // house / building — never exposed publicly
  area        String
  city        String
  state       String
  pincode     String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city])
  @@index([pincode])
  @@index([latitude, longitude])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---------------------------------------------------------------- catalogue

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]
}

model Book {
  id          String           @id @default(uuid())
  slug        String           @unique
  ownerId     String
  title       String
  author      String
  isbn        String?
  description String?
  categoryId  String?
  language    String           @default("English")
  edition     String?
  publishYear Int?
  condition   BookCondition    @default(GOOD)
  coverUrl    String?
  status      BookStatus       @default(AVAILABLE)
  moderation  ModerationStatus @default(APPROVED)
  available   Boolean          @default(true)
  viewCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  wantedBy      WantedBook[]
  wishlistedBy  WishlistItem[]
  offeredIn     Exchange[]      @relation("ExchangeOfferedBook")
  requestedIn   Exchange[]      @relation("ExchangeRequestedBook")
  exchangeItems ExchangeItem[]
  counterOffers ExchangeOffer[]

  @@index([ownerId])
  @@index([status, available])
  @@index([categoryId])
  @@index([title])
  @@index([author])
  @@index([isbn])
  @@index([createdAt])
}

/// A title the owner wants in return for a specific book they own.
model WantedBook {
  id        String   @id @default(uuid())
  bookId    String
  title     String
  author    String?
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([title])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  title     String
  author    String?
  bookId    String? // set when a concrete listing is wishlisted
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@unique([userId, title, author])
  @@index([userId])
  @@index([title])
}

// ---------------------------------------------------------------- exchange

model Exchange {
  id                 String         @id @default(uuid())
  code               String         @unique
  requesterId        String
  responderId        String
  offeredBookId      String // requester's book
  requestedBookId    String // responder's book
  status             ExchangeStatus @default(PENDING)
  matchScore         Int            @default(0)
  distanceKm         Float?
  message            String?
  feeAmount          Int            @default(0) // paise
  feeType            FeeType        @default(FIXED)
  deliveryMode       DeliveryMode?
  requesterCompleted Boolean        @default(false)
  responderCompleted Boolean        @default(false)
  expiresAt          DateTime?
  acceptedAt         DateTime?
  paidAt             DateTime?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  requester     User @relation("ExchangeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  responder     User @relation("ExchangeResponder", fields: [responderId], references: [id], onDelete: Cascade)
  offeredBook   Book @relation("ExchangeOfferedBook", fields: [offeredBookId], references: [id], onDelete: Cascade)
  requestedBook Book @relation("ExchangeRequestedBook", fields: [requestedBookId], references: [id], onDelete: Cascade)

  items        ExchangeItem[]
  offers       ExchangeOffer[]
  payments     Payment[]
  conversation Conversation?
  reviews      Review[]
  events       ExchangeEvent[]
  reports      Report[]

  @@index([requesterId])
  @@index([responderId])
  @@index([status])
  @@index([createdAt])
}

/// Immutable snapshot of which book moved in which direction.
model ExchangeItem {
  id            String       @id @default(uuid())
  exchangeId    String
  bookId        String
  fromRole      ExchangeRole
  titleSnapshot String
  createdAt     DateTime     @default(now())

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, bookId])
  @@index([exchangeId])
}

/// Counter offer: "I would rather have this other book of yours".
model ExchangeOffer {
  id           String       @id @default(uuid())
  exchangeId   String
  proposedById String
  bookId       String // the newly proposed book
  replaces     ExchangeRole // which side's book is being swapped out
  note         String?
  status       OfferStatus  @default(PROPOSED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  proposedBy User     @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([exchangeId])
  @@index([status])
}

model ExchangeEvent {
  id         String   @id @default(uuid())
  exchangeId String
  actorId    String?
  type       String
  detail     String?
  createdAt  DateTime @default(now())

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([exchangeId])
}

// ---------------------------------------------------------------- payments

model Payment {
  id                String        @id @default(uuid())
  exchangeId        String
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Int // paise
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  notes             Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exchangeId])
  @@index([userId])
  @@index([status])
}

/// Idempotency guard for Razorpay webhook redelivery.
model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  event     String
  payload   Json
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- messaging

model Conversation {
  id         String   @id @default(uuid())
  exchangeId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exchange     Exchange                  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------- social

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid())
  exchangeId String
  authorId   String
  subjectId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject  User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, authorId])
  @@index([subjectId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetUserId String?
  exchangeId   String?
  reason       String
  detail       String?
  status       ReportStatus @default(OPEN)
  resolution   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User?     @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  exchange   Exchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@index([status])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  body      String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
