# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookswap?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Razorpay (https://dashboard.razorpay.com/app/website-app-settings/api-keys) ----
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# Webhook secret from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=""

# ---- Geocoding ----
# Provider: "nominatim" (free, no key) or "locationiq" (needs key)
LOCATION_PROVIDER="nominatim"
LOCATION_API_KEY=""

# ---- Email (optional; leave blank to log emails to the server console) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="BookSwap <no-reply@bookswap.local>"

# ---- Seeded admin account ----
ADMIN_EMAIL="admin@bookswap.in"
ADMIN_PASSWORD="Admin@12345"
